# Copy to .env (or run `npm run setup`). Everything is optional — with no keys the
# whole pipeline runs in offline demo mode.

# ---- AI text provider --------------------------------------------------------
# auto | gemini | openai | claude | openrouter
AI_PROVIDER=auto
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.5-flash

# ---- YouTube -----------------------------------------------------------------
# Read-only research (trends, competitors). Free from Google Cloud Console.
YOUTUBE_API_KEY=
# Uploading/scheduling needs OAuth (Desktop client + refresh token). Put the
# client id/secret below, then run `npm run yt-token` to fill the refresh token
# automatically. Leave blank to keep publishing in mock mode while you learn.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ---- Voiceover ---------------------------------------------------------------
# Works out of the box for FREE: on macOS the built-in `say` voices are used when
# no ElevenLabs key is set — no signup required.
# Provider override: auto | say (free, local) | elevenlabs | mock
# VOICE_PROVIDER=auto
# Any installed macOS voice (list them with:  say -v '?')
# SAY_VOICE=Samantha
# ElevenLabs is optional — the most natural voice, but paid.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ---- Server ------------------------------------------------------------------
PORT=3456
