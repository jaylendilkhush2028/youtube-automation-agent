# Copy to .env (or run `npm run setup`). Everything is optional — with no keys the
# whole pipeline runs in offline demo mode.

# ---- AI text provider --------------------------------------------------------
# auto | gemini | openai | claude | openrouter
AI_PROVIDER=auto
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-flash-1.5

# ---- YouTube -----------------------------------------------------------------
# Read-only research (trends, competitors). Free from Google Cloud Console.
YOUTUBE_API_KEY=
# Uploading/scheduling needs OAuth (Desktop client + refresh token). Leave blank
# to keep publishing in mock mode while you learn.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ---- Voiceover (optional) ----------------------------------------------------
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ---- Server ------------------------------------------------------------------
PORT=3456
